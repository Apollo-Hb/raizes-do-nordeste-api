# Porta HTTP da API
PORT=3000
# Banco SQLite (arquivo criado automaticamente pelas migrations)
DATABASE_URL="file:./dev.db"
# Segredo do JWT - TROQUE em producao (minimo 32 caracteres)
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-32+"
# Validade do token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600
# Custo do bcrypt (10-12 recomendado)
BCRYPT_ROUNDS=10
# Gateway de pagamento simulado: tempo de resposta (ms) e tentativas em caso de falha
PAYMENT_MOCK_LATENCY_MS=150
PAYMENT_MAX_TENTATIVAS=3
# Tentativas de login FALHAS permitidas por IP a cada 15 minutos
LOGIN_RATE_LIMIT=20
