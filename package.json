{
  "name": "raizes-do-nordeste-api",
  "version": "1.0.0",
  "description": "API Back-end da rede de lanchonetes Raizes do Nordeste (pedidos multicanal, estoque por unidade, pagamento mock, fidelidade e LGPD)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma db seed",
    "test": "node scripts/test.js",
    "test:postman": "npx -y newman run postman/raizes-do-nordeste.postman_collection.json -e postman/local.postman_environment.json",
    "postman:gerar": "node scripts/gerar-postman.js"
  },
  "keywords": [],
  "author": "Apollo Hoinatz Bardini (RU 5586086)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@scarf/scarf": false
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
